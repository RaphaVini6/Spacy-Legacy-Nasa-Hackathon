# Copy this file to .env:  cp .env.example .env
# .env is ignored by git.
# .NET settings use "__" for nesting (Cors__Origins__0 = Cors:Origins[0] in appsettings.json).

# Development | Production
ASPNETCORE_ENVIRONMENT=Development

# Docker ports on the host machine (different from the full project so both can run together)
FRONTEND_PORT=8090
BACKEND_PORT=5090

# backend: frontend origins allowed by CORS
Cors__Origins__0=http://localhost:5173

# frontend: backend URL. Leave empty in development (Vite proxies /api to localhost:5000).
VITE_API_URL=
